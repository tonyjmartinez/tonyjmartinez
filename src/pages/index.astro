---
import Base from '../layouts/Base.astro';

const bio =
  'Software engineer with 9 years of experience focused on frontend and accessibility. I enjoy working at the intersection of engineering, product, and design to build engaging, accessible user experiences.';

// Each project links to its live deployment. Private repositories are never linked.
const work = [
  {
    title: 'Curb Cut',
    href: 'https://curb-cut.ajosephmartinez.workers.dev/',
    summary: 'Features built for disabled people quietly make everyday life better for everyone.',
  },
  {
    title: 'Tone Zone Survivors',
    href: 'https://tonezone-survivor.ajosephmartinez.workers.dev/',
    summary: 'A survivors-style action game in plain HTML5 canvas, playable in the browser.',
    source: 'https://github.com/tonyjmartinez/tonezone-survivor',
  },
  {
    title: 'Agent vs Agent',
    href: 'https://agent-vs-agent.ajosephmartinez.workers.dev/',
    summary: 'A bump-and-run spy board game for phone and desktop.',
    source: 'https://github.com/tonyjmartinez/agent-vs-agent',
  },
  {
    title: 'Succulents.info',
    href: 'https://succulents-info.ajosephmartinez.workers.dev/',
    summary: 'Plain-language succulent care guides, a plant library and a plant doctor.',
  },
];

const links = [
  { label: 'Email', href: 'mailto:ajosephmartinez@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/tonyjmartinez' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/tonyjmartinez' },
];
---

<Base title="Tony Martinez · Frontend and accessibility engineer" description={bio}>
  <div class="wrap page">
    <header class="intro">
      <h1>Tony Martinez</h1>
      <p class="role">Frontend and accessibility engineer</p>
      <p class="bio">{bio}</p>
      <ul class="links" aria-label="Contact">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </header>

    <section id="work" aria-labelledby="work-title">
      <h2 id="work-title">Projects</h2>
      <ul class="work-list">
        {
          work.map((w) => (
            <li>
              <a class="work-title" href={w.href}>{w.title}</a>
              <p>{w.summary}</p>
              {w.source && (
                <a class="work-source" href={w.source}>
                  Source<span class="visually-hidden"> code for {w.title}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 40rem;
    padding-block: clamp(3rem, 10vw, 6rem) var(--space-6);
  }
  h1 {
    font-size: var(--step-4);
    margin: 0 0 var(--space-2);
  }
  .role {
    margin: 0 0 var(--space-5);
    color: var(--accent);
    font-weight: 700;
  }
  .bio {
    margin: 0 0 var(--space-5);
    color: var(--text-muted);
  }
  .links,
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links li,
  .work-list li {
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .links a,
  .work-source {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
  }
  #work {
    margin-top: var(--space-7);
  }
  h2 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-4);
  }
  .work-list {
    display: grid;
    gap: var(--space-5);
  }
  .work-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }
  .work-list p {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
  }
  .work-source {
    font-size: var(--step--1);
  }
</style>
