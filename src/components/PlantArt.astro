---
/**
 * Flat, thick-outlined succulent illustrations drawn entirely in SVG.
 * Decorative by default: plant names always appear in nearby text.
 */
import type { ArtKind } from '../data/taxonomy';

interface Props {
  kind: ArtKind;
  leaf: string;
  tip?: string;
  pot?: string;
  sun?: boolean;
  class?: string;
  /** Provide only when the image adds meaning not present in surrounding text. */
  label?: string;
}

const { kind, leaf, tip = '#ff86ad', pot = '#d9693f', sun = true, class: className, label } = Astro.props;

const INK = '#0e2318';
const CREAM = '#fff7e8';
const SW = 4; // outline width

// --- tiny colour helper -------------------------------------------------
function mix(hex: string, target: string, amount: number) {
  const a = hex.replace('#', '');
  const b = target.replace('#', '');
  const out = [0, 2, 4]
    .map((i) => {
      const x = parseInt(a.slice(i, i + 2), 16);
      const y = parseInt(b.slice(i, i + 2), 16);
      return Math.round(x + (y - x) * amount)
        .toString(16)
        .padStart(2, '0');
    })
    .join('');
  return `#${out}`;
}
const dark = mix(leaf, INK, 0.28);
const light = mix(leaf, '#ffffff', 0.3);

// --- shape helpers ------------------------------------------------------
/** A pointed leaf growing straight up from (0,0). */
function leafPath(len: number, w: number) {
  return `M0 0 C ${-w} ${-len * 0.35} ${-w * 0.7} ${-len * 0.8} 0 ${-len} C ${w * 0.7} ${-len * 0.8} ${w} ${-len * 0.35} 0 0 Z`;
}
/** A rounded, paddle-shaped leaf. */
function paddlePath(len: number, w: number) {
  return `M0 0 C ${-w * 0.9} ${-len * 0.2} ${-w} ${-len * 0.85} 0 ${-len} C ${w} ${-len * 0.85} ${w * 0.9} ${-len * 0.2} 0 0 Z`;
}
/** A blunt, strap-like leaf (snake plant). */
function swordPath(len: number, w: number) {
  return `M${-w * 0.45} 0 C ${-w * 0.6} ${-len * 0.5} ${-w * 0.5} ${-len * 0.85} 0 ${-len} C ${w * 0.5} ${-len * 0.85} ${w * 0.6} ${-len * 0.5} ${w * 0.45} 0 Z`;
}
/** Point on a quadratic bezier. */
function qPoint(p0: number[], p1: number[], p2: number[], t: number) {
  const u = 1 - t;
  return [u * u * p0[0] + 2 * u * t * p1[0] + t * t * p2[0], u * u * p0[1] + 2 * u * t * p1[1] + t * t * p2[1]];
}

type Shape = { el: string; attrs: Record<string, string | number> };
const shapes: Shape[] = [];
const front: Shape[] = []; // drawn after the pot
const add = (el: string, attrs: Record<string, string | number>, list = shapes) => list.push({ el, attrs });
const outline = { stroke: INK, 'stroke-width': SW, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' };

const BASE_X = 100;
const BASE_Y = 138;
/** Trailing plants get a raised pot so their stems have room to hang. */
const potY = kind === 'pearls' || kind === 'tail' ? -56 : 0;

function rosette(cx: number, cy: number, s: number, list = shapes) {
  const layers = [
    { angles: [-78, -52, -26, 0, 26, 52, 78], len: 62, w: 24, fill: dark, tipDot: true },
    { angles: [-60, -30, 0, 30, 60], len: 50, w: 22, fill: leaf, tipDot: true },
    { angles: [-32, 0, 32], len: 34, w: 16, fill: light, tipDot: false },
  ];
  for (const layer of layers) {
    for (const a of layer.angles) {
      const t = `translate(${cx} ${cy}) scale(${s}) rotate(${a})`;
      add('path', { d: leafPath(layer.len, layer.w), fill: layer.fill, transform: t, ...outline }, list);
      if (layer.tipDot) add('circle', { cx: 0, cy: -layer.len + 7, r: 4.5, fill: tip, transform: t }, list);
    }
  }
}

switch (kind) {
  case 'rosette':
    rosette(BASE_X, BASE_Y, 1.3);
    break;

  case 'colony':
    rosette(BASE_X, BASE_Y, 1.05);
    rosette(58, 150, 0.45, front);
    rosette(146, 148, 0.5, front);
    break;

  case 'aloe': {
    const leaves = [
      [-50, 78],
      [50, 80],
      [-34, 96],
      [34, 98],
      [-16, 108],
      [16, 110],
      [0, 116],
    ];
    for (const [a, len] of leaves) {
      const t = `translate(${BASE_X} ${BASE_Y}) rotate(${a})`;
      add('path', { d: leafPath(len, 15), fill: a === 0 ? light : leaf, transform: t, ...outline });
      for (const f of [0.3, 0.48, 0.66]) {
        add('circle', { cx: f * 6 - 2, cy: -len * f, r: 2.4, fill: CREAM, transform: t });
      }
    }
    break;
  }

  case 'zebra': {
    const leaves = [
      [-44, 64],
      [44, 66],
      [-28, 80],
      [28, 82],
      [-11, 92],
      [12, 90],
    ];
    for (const [a, len] of leaves) {
      const t = `translate(${BASE_X} ${BASE_Y}) rotate(${a})`;
      add('path', { d: leafPath(len, 15), fill: leaf, transform: t, ...outline });
      for (let f = 0.18; f < 0.78; f += 0.12) {
        const half = 9 * Math.sin(Math.PI * (1 - f) * 0.9) * (1 - f * 0.6);
        add('path', {
          d: `M${-half} ${-len * f} L${half} ${-len * f}`,
          stroke: CREAM,
          'stroke-width': 3.5,
          'stroke-linecap': 'round',
          transform: t,
        });
      }
    }
    break;
  }

  case 'jade': {
    const trunk = 'M100 140 C 99 120 100 108 100 96 M100 118 C 90 108 80 102 68 92 M100 108 C 112 100 122 94 134 86';
    add('path', { d: trunk, fill: 'none', stroke: INK, 'stroke-width': 16, 'stroke-linecap': 'round' });
    add('path', { d: trunk, fill: 'none', stroke: '#9b6a45', 'stroke-width': 8, 'stroke-linecap': 'round' });
    const clusters: [number, number][] = [
      [68, 90],
      [134, 84],
      [100, 92],
    ];
    for (const [x, y] of clusters) {
      for (const a of [-70, -35, 0, 35, 70]) {
        const t = `translate(${x} ${y}) rotate(${a})`;
        add('path', { d: paddlePath(30, 13), fill: a === 0 ? light : leaf, transform: t, ...outline });
        add('path', { d: 'M-5 -27 Q0 -31 5 -27', fill: 'none', stroke: tip, 'stroke-width': 4, 'stroke-linecap': 'round', transform: t });
      }
    }
    break;
  }

  case 'pearls':
  case 'tail': {
    // Trailing plants sit in a raised pot (see potY) so their stems can cascade.
    const top = BASE_Y + potY;
    for (const x of [72, 86, 100, 114, 128]) {
      add('circle', { cx: x, cy: top - 6 - (x % 3) * 2, r: kind === 'pearls' ? 8 : 9, fill: leaf, ...outline });
    }
    const strands: [number[], number[], number[]][] = [
      [[60, top + 4], [44, top + 40], [40, top + 92]],
      [[82, top + 6], [72, top + 60], [80, top + 112]],
      [[110, top + 6], [126, top + 56], [118, top + 106]],
      [[138, top + 4], [158, top + 36], [160, top + 84]],
    ];
    for (const [p0, p1, p2] of strands) {
      const d = `M${p0[0]} ${p0[1]} Q${p1[0]} ${p1[1]} ${p2[0]} ${p2[1]}`;
      add('path', { d, fill: 'none', stroke: INK, 'stroke-width': 3 }, front);
      const length = Math.hypot(p2[0] - p0[0], p2[1] - p0[1]);
      const steps = Math.round(length / (kind === 'pearls' ? 15 : 10));
      const points = Array.from({ length: steps }, (_, i) => qPoint(p0, p1, p2, (i + 0.5) / steps));
      // draw bottom-up so upper beads overlap lower ones, like real stems
      for (const [x, y] of points.reverse()) {
        if (kind === 'pearls') {
          add('circle', { cx: x, cy: y, r: 7, fill: leaf, ...outline, 'stroke-width': 3.5 }, front);
          add('path', { d: `M${x - 3} ${y - 2} q3 -3 6 0`, fill: 'none', stroke: CREAM, 'stroke-width': 2.5, 'stroke-linecap': 'round' }, front);
        } else {
          add('ellipse', { cx: x, cy: y, rx: 8.5, ry: 6.5, fill: leaf, ...outline, 'stroke-width': 3.5 }, front);
        }
      }
    }
    break;
  }

  case 'pebbles': {
    const pairs: [number, number, number, string][] = [
      [76, 140, 1, leaf],
      [124, 138, 0.9, mix(leaf, tip, 0.35)],
    ];
    for (const [x, y, s, fill] of pairs) {
      const t = `translate(${x} ${y}) scale(${s})`;
      add('path', { d: 'M-24 0 L-24 -22 C-24 -40 24 -40 24 -22 L24 0 Z', fill, transform: t, ...outline }, front);
      add('path', { d: 'M0 -34 L0 -14', stroke: INK, 'stroke-width': SW, 'stroke-linecap': 'round', transform: t }, front);
      add('path', { d: 'M-17 -26 q4 -6 9 -2 M8 -28 q5 -4 9 1', fill: 'none', stroke: mix(fill, INK, 0.35), 'stroke-width': 3, 'stroke-linecap': 'round', transform: t }, front);
    }
    // a little daisy
    const fx = 100;
    const fy = 92;
    add('path', { d: `M${fx} ${fy + 8} Q ${fx + 2} ${fy + 22} ${fx + 2} 108`, fill: 'none', stroke: INK, 'stroke-width': SW }, front);
    for (let a = 0; a < 360; a += 40) {
      add('ellipse', { cx: fx, cy: fy - 11, rx: 4.5, ry: 10, fill: '#ffd23f', transform: `rotate(${a} ${fx} ${fy})`, ...outline, 'stroke-width': 3 }, front);
    }
    add('circle', { cx: fx, cy: fy, r: 6.5, fill: '#e9825a', ...outline, 'stroke-width': 3 }, front);
    break;
  }

  case 'sword': {
    const leaves = [
      [-16, 96],
      [16, 100],
      [-6, 122],
      [7, 112],
    ];
    for (const [a, len] of leaves) {
      const t = `translate(${BASE_X + a * 0.6} ${BASE_Y}) rotate(${a * 0.6})`;
      add('path', { d: swordPath(len, 28), fill: tip, transform: t, ...outline });
      add('path', { d: swordPath(len - 6, 18), fill: leaf, transform: t });
      for (let y = 20; y < len - 20; y += 16) {
        add('path', { d: `M-7 ${-y} q3.5 -4 7 0 t7 0`, fill: 'none', stroke: dark, 'stroke-width': 3, 'stroke-linecap': 'round', transform: t });
      }
    }
    break;
  }

  case 'fuzzy': {
    add('path', { d: 'M100 140 L100 72', stroke: INK, 'stroke-width': 10, 'stroke-linecap': 'round' });
    const pairs: [number, number, number][] = [
      [126, 62, 46],
      [108, 46, 42],
      [92, 28, 38],
    ];
    for (const [y, a, len] of pairs) {
      for (const dir of [-1, 1]) {
        const t = `translate(100 ${y}) rotate(${a * dir})`;
        add('path', { d: paddlePath(len, 16), fill: leaf, transform: t, ...outline });
        for (const [dx, dy] of [[-6, 7], [0, 4], [6, 7]]) {
          add('circle', { cx: dx, cy: -len + dy, r: 2.6, fill: tip, transform: t });
        }
      }
    }
    const t = 'translate(100 76)';
    add('path', { d: paddlePath(36, 15), fill: light, transform: t, ...outline });
    for (const [dx, dy] of [[-5, 7], [0, 4], [5, 7]]) {
      add('circle', { cx: dx, cy: -36 + dy, r: 2.6, fill: tip, transform: t });
    }
    break;
  }

  case 'bush': {
    const branches: [number[], number[], number[]][] = [
      [[100, 140], [96, 110], [100, 66]],
      [[100, 128], [80, 116], [60, 88]],
      [[100, 122], [124, 112], [142, 80]],
      [[98, 104], [84, 90], [80, 64]],
      [[102, 100], [118, 86], [122, 58]],
    ];
    for (const [p0, p1, p2] of branches) {
      const d = `M${p0[0]} ${p0[1]} Q${p1[0]} ${p1[1]} ${p2[0]} ${p2[1]}`;
      add('path', { d, fill: 'none', stroke: INK, 'stroke-width': 11, 'stroke-linecap': 'round' });
      add('path', { d, fill: 'none', stroke: tip, 'stroke-width': 4.5, 'stroke-linecap': 'round' });
    }
    for (const [p0, p1, p2] of branches) {
      for (let i = 1; i <= 5; i++) {
        const [x, y] = qPoint(p0, p1, p2, i / 5);
        const side = i % 2 ? -1 : 1;
        add('circle', { cx: x + side * 8, cy: y, r: 7.5, fill: i % 3 ? leaf : light, ...outline, 'stroke-width': 3.5 });
      }
    }
    break;
  }
}

const potRim = mix(pot, INK, 0.12);
---

<svg
  class:list={['plant-art', className]}
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {sun && <circle cx="160" cy={potY ? 30 : 40} r={potY ? 16 : 22} fill={CREAM} stroke={INK} stroke-width={SW} />}
  {shapes.map(({ el, attrs }) => (el === 'path' ? <path {...attrs} /> : el === 'circle' ? <circle {...attrs} /> : <ellipse {...attrs} />))}
  <g transform={`translate(0 ${potY})`}>
    <path d="M54 150 L146 150 L136 194 L64 194 Z" fill={pot} stroke={INK} stroke-width={SW} stroke-linejoin="round" />
    <rect x="44" y="132" width="112" height="22" rx="6" fill={potRim} stroke={INK} stroke-width={SW} />
  </g>
  {front.map(({ el, attrs }) => (el === 'path' ? <path {...attrs} /> : el === 'circle' ? <circle {...attrs} /> : <ellipse {...attrs} />))}
</svg>

<style>
  .plant-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
