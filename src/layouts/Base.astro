---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tony Martinez',
  url: Astro.site?.href,
  jobTitle: 'Software engineer',
  description,
  sameAs: ['https://github.com/tonyjmartinez', 'https://www.linkedin.com/in/tonyjmartinez'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tony Martinez" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:locale" content="en_US" />
    <meta name="theme-color" content="#fff7e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1912" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tony Martinez" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} Tony Martinez</p>
        <button type="button" class="theme-toggle" aria-pressed="false" hidden>
          <span class="theme-label">Dark theme</span>
        </button>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        btn.hidden = false;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function isDark() {
          var t = root.dataset.theme;
          return t ? t === 'dark' : mq.matches;
        }
        function sync() {
          btn.setAttribute('aria-pressed', String(isDark()));
        }
        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
        mq.addEventListener('change', sync);
        sync();
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--sun);
    color: var(--on-accent);
    font-weight: 800;
    border: var(--border) solid var(--ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    padding-block: var(--space-5);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .site-footer .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .site-footer p {
    margin: 0;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle {
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: var(--border-thin) solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.35rem 1rem;
    cursor: pointer;
    box-shadow: var(--lift-sm) var(--lift-sm) 0 var(--shadow);
  }

  .theme-toggle[aria-pressed='true'] .theme-label::after {
    content: ': on';
  }

  .theme-toggle[aria-pressed='false'] .theme-label::after {
    content: ': off';
  }

  @media print {
    .theme-toggle,
    .skip-link {
      display: none;
    }
  }
</style>
